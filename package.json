{
  "name": "espresso-mvc",
  "version": "0.1.1",
  "description": "espresso — lightweight TypeScript framework for building REST APIs and MVC apps on web-standard Request/Response",
  "keywords": [
    "framework",
    "web",
    "rest",
    "api",
    "mvc",
    "http",
    "router",
    "templating",
    "typescript"
  ],
  "license": "MIT",
  "author": "pragmatica team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pragmaticateam/espresso.git"
  },
  "homepage": "https://github.com/pragmaticateam/espresso#readme",
  "bugs": {
    "url": "https://github.com/pragmaticateam/espresso/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "pretest": "npm run build",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
