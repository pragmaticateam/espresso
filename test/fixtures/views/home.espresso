{{ partial 'top' }}
<h1>{{ title }}</h1>
{{ #if user }}
  <p>Hello, {{ user.name }}!</p>
  {{ ^user.admin }}
    <p>Ask for admin access.</p>
  {{ /user.admin }}
{{ else }}
  <p>Please log in.</p>
{{ /if }}
<ul>
  {{ #each items }}
    <li data-i="{{ @index }}">{{ this }} & {{ title }}</li>
  {{ else }}
    <li>nothing here</li>
  {{ /each }}
</ul>
{{ partial 'greet' visitor }}
{{ partial 'loop' }}
{{{ rawHtml }}}
